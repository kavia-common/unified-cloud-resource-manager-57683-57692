# PUBLIC INTERFACE
# Example environment variables required by the React frontend dashboard.
# Copy this file to ".env" and provide real values before running locally.

# Supabase public project URL (e.g., https://<project-ref>.supabase.co)
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon public key
REACT_APP_SUPABASE_KEY=your-anon-public-key
